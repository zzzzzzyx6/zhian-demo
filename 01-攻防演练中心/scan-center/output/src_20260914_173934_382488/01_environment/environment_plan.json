        "content": "#!/usr/bin/env bash\nset -euo pipefail\n\ncmd=\"${1:-check}\"\ncase \"$cmd\" in\n  shell)\n    exec /bin/bash\n    ;;\n  check)\n    exec /opt/shuan/scripts/check_container.sh\n    ;;\n  provision)\n    shift || true\n    exec /opt/shuan/scripts/provision_runtime.sh \"$@\"\n    ;;\n  *)\n    exec \"$@\"\n    ;;\nesac\n"
      },
